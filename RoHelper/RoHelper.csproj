<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 指定 Windows 10 版本才拿得到 WinRT API（Windows.Media.Ocr，視覺判斷的 OCR 用） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>RoHelper</RootNamespace>
    <AssemblyName>RoHelper</AssemblyName>
    <Version>8.2.0</Version>
    <Product>RO Survivors 小幫手</Product>
  </PropertyGroup>

  <!-- 發佈成單一 exe（自帶 .NET，對方電腦不用另外裝）：dotnet publish -c Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- WebView2 套件一律引用 WPF 版 dll，跟 WinForms 專案的 WindowsBase 版本衝突（MSB3277 警告）；WinForms 用不到，解析前拿掉 -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- engine.js 不編進 exe：只當規則清單的來源，tools/gen-schema.js 從它產生 schema.json，BuiltInSchemaTests 也會讀它 -->
    <EmbeddedResource Include="Engine\schema.json" LogicalName="RoHelper.schema.json" />
    <!-- 內建範本（按鈕截圖）：新電腦的 %AppData%\RoHelper\templates 是空的，沒有這些就認不出畫面；使用者自己存的同名範本優先 -->
    <EmbeddedResource Include="Templates\*.png;Templates\*.json" LogicalName="RoHelper.Templates.%(Filename)%(Extension)" />
    <!-- 新版面板的介面檔案：由 PanelAssets 依網址取出（WebView2 的 WebResourceRequested），發佈仍是單一 exe -->
    <EmbeddedResource Include="Panel\web\*.html;Panel\web\*.css;Panel\web\*.js" LogicalName="RoHelper.Panel.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
